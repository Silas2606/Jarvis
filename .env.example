# Copy to .env and fill in, or simply export these in your shell.

# Required: the brain.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides -- everything also lives in ~/.jarvis/config.toml.
# JARVIS_ADDRESS=Sir
# JARVIS_TIMEZONE=Europe/Berlin
# JARVIS_VOICE_LANGUAGE=de
# JARVIS_VOICE_TTS_ENGINE=piper
# JARVIS_VOICE_PIPER_MODEL=/path/to/de_DE-thorsten-medium.onnx
# JARVIS_VOICE_BARGE_IN=true
# JARVIS_BRAIN_EFFORT=low
# JARVIS_BRAIN_SHOW_THINKING=false
# JARVIS_TOOLS_CONFIRM_OUTBOUND=true
